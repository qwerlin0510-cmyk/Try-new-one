[
 {
  "line": 1,
  "text": "你減掉的脂肪，到底跑去哪了？",
  "start": 0.0,
  "end": 2.3
 },
 {
  "line": 2,
  "text": "流汗流掉？上廁所排掉？還是變成肌肉？",
  "start": 2.5,
  "end": 5.9
 },
 {
  "line": 3,
  "text": "答案，跟你想的不一樣。",
  "start": 6.08,
  "end": 7.88
 },
 {
  "line": 4,
  "text": "身體隨時都在消耗能量，連睡覺都不例外。",
  "start": 8.14,
  "end": 11.6
 },
 {
  "line": 5,
  "text": "能量主要來自醣類和脂肪。",
  "start": 11.78,
  "end": 13.8
 },
 {
  "line": 6,
  "text": "當吃進來的熱量不夠用，身體就會動用存起來的脂肪。",
  "start": 14.02,
  "end": 18.0
 },
 {
  "line": 7,
  "text": "脂肪細胞裡存的叫三酸甘油酯，就像一根甘油掛著三條脂肪酸。",
  "start": 18.48,
  "end": 23.52
 },
 {
  "line": 8,
  "text": "身體一發出「需要能量」的訊號，它就被拆開。",
  "start": 23.66,
  "end": 26.84
 },
 {
  "line": 9,
  "text": "脂肪酸跟著血液，送到肌肉等需要能量的地方。",
  "start": 26.84,
  "end": 30.46
 },
 {
  "line": 10,
  "text": "脂肪酸來到細胞裡的發電廠：粒線體。",
  "start": 30.72,
  "end": 33.68
 },
 {
  "line": 11,
  "text": "在氧氣幫忙下，它被一段一段拆解、燃燒，",
  "start": 34.02,
  "end": 37.6
 },
 {
  "line": 12,
  "text": "變成身體可以使用的能量。",
  "start": 37.74,
  "end": 39.66
 },
 {
  "line": 13,
  "text": "燒完之後，脂肪剩下什麼？",
  "start": 39.82,
  "end": 41.8
 },
 {
  "line": 14,
  "text": "大約84%變成二氧化碳，從呼吸吐出去；",
  "start": 42.2,
  "end": 45.78
 },
 {
  "line": 15,
  "text": "剩下約16%變成水，透過尿液、汗水和呼吸排出。",
  "start": 46.06,
  "end": 50.54
 },
 {
  "line": 16,
  "text": "所以脂肪大多是被「呼」出去的，不是流汗流掉的。",
  "start": 51.22,
  "end": 54.76
 },
 {
  "line": 17,
  "text": "長期維持熱量赤字，才是減脂的關鍵。",
  "start": 55.04,
  "end": 57.84
 }
]