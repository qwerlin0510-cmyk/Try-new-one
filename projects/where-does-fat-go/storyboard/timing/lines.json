[
 {
  "line": 1,
  "text": "你減掉的脂肪，到底跑去哪了？",
  "start": 0.0,
  "end": 2.091
 },
 {
  "line": 2,
  "text": "流汗流掉？上廁所排掉？還是變成肌肉？",
  "start": 2.273,
  "end": 5.364
 },
 {
  "line": 3,
  "text": "答案，跟你想的不一樣。",
  "start": 5.527,
  "end": 7.164
 },
 {
  "line": 4,
  "text": "身體隨時都在消耗能量，連睡覺都不例外。",
  "start": 7.4,
  "end": 10.545
 },
 {
  "line": 5,
  "text": "能量主要來自醣類和脂肪。",
  "start": 10.709,
  "end": 12.545
 },
 {
  "line": 6,
  "text": "當吃進來的熱量不夠用，身體就會動用存起來的脂肪。",
  "start": 12.745,
  "end": 16.364
 },
 {
  "line": 7,
  "text": "脂肪細胞裡存的叫三酸甘油酯，就像一根甘油掛著三條脂肪酸。",
  "start": 16.8,
  "end": 21.382
 },
 {
  "line": 8,
  "text": "身體一發出「需要能量」的訊號，它就被拆開。",
  "start": 21.509,
  "end": 24.4
 },
 {
  "line": 9,
  "text": "脂肪酸跟著血液，送到肌肉等需要能量的地方。",
  "start": 24.4,
  "end": 27.691
 },
 {
  "line": 10,
  "text": "脂肪酸來到細胞裡的發電廠：粒線體。",
  "start": 27.927,
  "end": 30.618
 },
 {
  "line": 11,
  "text": "在氧氣幫忙下，它被一段一段拆解、燃燒，",
  "start": 30.927,
  "end": 34.182
 },
 {
  "line": 12,
  "text": "變成身體可以使用的能量。",
  "start": 34.309,
  "end": 36.055
 },
 {
  "line": 13,
  "text": "燒完之後，脂肪剩下什麼？",
  "start": 36.2,
  "end": 38.0
 },
 {
  "line": 14,
  "text": "大約84%變成二氧化碳，從呼吸吐出去；",
  "start": 38.364,
  "end": 41.618
 },
 {
  "line": 15,
  "text": "剩下約16%變成水，透過尿液、汗水和呼吸排出。",
  "start": 41.873,
  "end": 45.945
 },
 {
  "line": 16,
  "text": "所以脂肪大多是被「呼」出去的，不是流汗流掉的。",
  "start": 46.564,
  "end": 49.782
 },
 {
  "line": 17,
  "text": "長期維持熱量赤字，才是減脂的關鍵。",
  "start": 50.036,
  "end": 52.582
 }
]